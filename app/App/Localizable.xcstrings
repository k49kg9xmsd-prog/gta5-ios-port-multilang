          "stringUnit": {
            "state": "translated",
            "value": " · 立即生效"
          }
        }
      }
    },
    ". That usually means this setting needs more memory than iOS gives the app on this iPhone (about {arg0} MB).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". That usually means this setting needs more memory than iOS gives the app on this iPhone (about {arg0} MB)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。這通常代表目前設定超過 iOS 分配給 App 的記憶體上限（約 {arg0} MB）。"
          }
        }
      }
    },
