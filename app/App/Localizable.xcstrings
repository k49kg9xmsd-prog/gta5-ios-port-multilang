{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe game now starts at its usual resolution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe game now starts at its usual resolution"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n現在改用一般解析度啟動"
          }
        }
      }
    },
    "\n\nThe game now starts on {arg0}": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe game now starts on {arg0}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n現在改用「{arg0}」啟動"
          }
        }
      }
    },
    "\n⚠︎ Heavier than this phone's recommended setting: may run out of memory or overheat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Heavier than this phone's recommended setting: may run out of memory or overheat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ 高於此裝置的建議設定，可能記憶體不足或過熱。"
          }
        }
      }
    },
    " (playing now)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (playing now)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（目前遊玩中）"
          }
        }
      }
    },
    " (recommended)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (recommended)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（建議）"
          }
        }
      }
    },
    " Close and reopen the app to play {arg0}.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Close and reopen the app to play {arg0}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 關閉再重新開啟 App，即可進入 {arg0}。"
          }
        }
      }
    },
    " Presets above the recommended one can run out of memory or overheat on this phone; if a launch fails, the game falls back automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Presets above the recommended one can run out of memory or overheat on this phone; if a launch fails, the game falls back automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 高於建議的畫質可能導致記憶體不足或裝置過熱；若無法啟動，將自動降低設定。"
          }
        }
      }
    },
    " Removing files also clears the startup set; the next Play prepares it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Removing files also clears the startup set; the next Play prepares it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 刪除檔案也會清除啟動所需的快取；下次遊玩時會重新準備。"
          }
        }
      }
    },
    " Restart needed for {arg0}.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Restart needed for {arg0}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 必須重新啟動才能套用「{arg0}」。"
          }
        }
      }
    },
    " You can change this any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " You can change this any time in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在「設定」中修改。"
          }
        }
      }
    },
    " at {arg0}p": {
      "extractionState": "manual",
      "localizations": {
